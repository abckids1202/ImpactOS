DATABASE_URL=sqlite:///./impactos.db
APP_ENV=development
APP_MODE=DEMO
FRONTEND_ORIGIN=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false
SESSION_COOKIE_NAME=impactos_session
SESSION_TTL_SECONDS=43200
IMPACTOS_SECRET_KEY=change-this-local-secret
DEVELOPMENT_SEED_ENABLED=true
# Optional comma-separated domains for verified school-email activation.
APPROVED_EMAIL_DOMAINS=
